// Faro ingest writing straight to Loki and Tempo, with no collector anywhere.
//
// Selected by entrypoint.sh when RAILWAY_LOKI_ENDPOINT and RAILWAY_TEMPO_ENDPOINT
// are set and no upstream gateway is configured. config.alloy is the forwarding
// variant, used when OTEL_EXPORTER_OTLP_ENDPOINT points at a gateway instead.
//
// faro.receiver emits logs and traces only — it produces no metrics. The RED
// numbers on the frontend dashboard are LogQL aggregations over the Faro events
// in Loki (count_over_time, quantiles over logfmt fields), which is how Grafana
// Cloud's Frontend Observability derives them too. Tempo's metrics generator
// additionally turns the Faro spans into span metrics.
//
// So this path still needs Prometheus if Tempo is deployed: Tempo refuses to
// start with an empty metrics_generator remote_write URL. The saving over a
// collector-fronted stack is the collector, not a backend.

faro.receiver "clients" {
	// Loki labels come only from this map. An empty value tells the receiver to
	// copy the key from the Faro payload, so each line carries the app's own
	// identity. otelcol.processor.transform.faro_logs lifts these onto the
	// resource, which is where Loki reads service.name from.
	extra_log_labels = {
		app_name        = "",
		app_version     = "",
		app_environment = "",
		kind            = "",
	}

	server {
		// Railway's private network is dual-stack. "[::]" binds both families. The
		// brackets are required: this value is joined to the port with a bare
		// colon, and a plain "::" yields ":::12347", which Go refuses to listen on.
		listen_address = "[::]"
		listen_port    = 12347

		// Browsers enforce this list; native shells and curl do not. Set
		// FARO_CORS_ALLOWED_ORIGINS to your deployed frontend origins — it replaces
		// the fallback, so production does not keep localhost allowed.
		cors_allowed_origins = string.split(coalesce(
			sys.env("FARO_CORS_ALLOWED_ORIGINS"),
			"capacitor://localhost,ionic://localhost,http://localhost,https://localhost,http://localhost:3000,http://localhost:5173",
		), ",")

		// Every client sends this as `x-api-key`; a wrong or missing key gets 401.
		// The key ships inside app bundles, so it filters noise rather than
		// authenticates. The rate limit, the payload cap and the CORS list are the
		// real controls on this public write path.
		api_key = sys.env("FARO_API_KEY")

		// A Faro batch is a few KB. Anything near the 5 MiB default is not a client.
		max_allowed_payload_size = "1MiB"

		rate_limiting {
			enabled    = true
			strategy   = "per_app"
			rate       = 50
			burst_size = 100
		}
	}

	output {
		logs   = [otelcol.receiver.loki.faro.receiver]
		traces = [otelcol.processor.batch.traces.input]
	}
}

// faro.receiver emits logs in Loki's form; the exporters speak OTLP. The labels
// land as log record attributes here, not on the resource.
otelcol.receiver.loki "faro" {
	output {
		logs = [otelcol.processor.transform.faro_logs.input]
	}
}

// Loki indexes service.name, service.namespace and deployment.environment.name
// from RESOURCE attributes on OTLP ingest. Without this lift every Faro line
// lands under service_name="unknown_service". otelcol.receiver.loki builds a
// fresh plog.Logs per entry, so writing the resource from the log context is
// safe. service.namespace="faro" gives Loki one selector for retention and
// dashboards; the record keeps `kind` as structured metadata.
otelcol.processor.transform "faro_logs" {
	error_mode = "ignore"

	log_statements {
		context    = "log"
		statements = [
			`set(resource.attributes["service.name"], log.attributes["app_name"]) where log.attributes["app_name"] != nil`,
			`set(resource.attributes["service.version"], log.attributes["app_version"]) where log.attributes["app_version"] != nil`,
			`set(resource.attributes["deployment.environment.name"], log.attributes["app_environment"]) where log.attributes["app_environment"] != nil`,
			`set(resource.attributes["service.namespace"], "faro")`,
			`delete_key(log.attributes, "app_name")`,
			`delete_key(log.attributes, "app_version")`,
			`delete_key(log.attributes, "app_environment")`,
			`delete_key(log.attributes, "loki.attribute.labels")`,
		]
	}

	output {
		logs = [otelcol.processor.batch.logs.input]
	}
}

// Hard record cap so a single push stays well under Loki's gRPC message-size
// limit; Loki 503s the whole batch when it does not.
otelcol.processor.batch "logs" {
	send_batch_size     = 1000
	send_batch_max_size = 2000
	timeout             = "1s"

	output {
		logs = [otelcol.exporter.otlphttp.loki.input]
	}
}

otelcol.processor.batch "traces" {
	output {
		traces = [otelcol.exporter.otlphttp.tempo.input]
	}
}

// Plaintext is acceptable because these hops never leave the Railway project.

otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = sys.env("RAILWAY_LOKI_ENDPOINT")

		tls {
			insecure = true
		}
	}
}

otelcol.exporter.otlphttp "tempo" {
	client {
		endpoint = sys.env("RAILWAY_TEMPO_ENDPOINT")

		tls {
			insecure = true
		}
	}
}
